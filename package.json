{
  "name": "fibonacci-poker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "lint": "eslint apps packages tests scripts ops --no-error-on-unmatched-pattern",
    "test": "vitest run",
    "test:domain": "vitest run tests/domain",
    "test:storage": "vitest run tests/storage",
    "test:realtime": "vitest run tests/realtime",
    "test:web": "vitest run tests/web",
    "verify": "node scripts/check-patterns.mjs && npm run typecheck && npm run lint && npm test && python3 scripts/check-plans.py",
    "check:i18n": "node --import tsx scripts/check-i18n.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "build": "vite build apps/web --config apps/web/vite.config.ts && esbuild apps/server/src/main.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/server/main.js",
    "dev": "tsx watch apps/server/src/main.ts",
    "dev:web": "vite apps/web --config apps/web/vite.config.ts",
    "start": "node dist/server/main.js",
    "test:load": "node tests/load/team.mjs",
    "test:recovery": "vitest run tests/ops/recovery.test.ts",
    "test:ops": "vitest run tests/ops"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1153.0",
    "@colyseus/core": "0.18.19",
    "@colyseus/schema": "5.0.41",
    "@colyseus/sdk": "0.18.5",
    "@colyseus/ws-transport": "0.18.4",
    "better-sqlite3": "13.0.3",
    "cookie": "2.0.1",
    "express": "5.3.0",
    "preact": "11.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
